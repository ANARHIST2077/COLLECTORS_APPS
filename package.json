{
  "name": "hotwheels-app",
  "version": "2.1.0",
  "main": "main.js",
  "scripts": {
    "build:web": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable",
    "android": "vite build && cap sync android"
  },
  "build": {
    "appId": "com.anarhist2077.hotwheels",
    "artifactName": "HotWheels-Collection-${version}-portable.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main-storage.js",
      "preload.js",
      "www/**",
      "!node_modules/@capacitor/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^38.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.3.5"
  },
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "fs-extra": "^11.3.1"
  }
}
